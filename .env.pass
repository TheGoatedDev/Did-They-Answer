# Secret references for `pass-cli run --env-file .env.pass -- pnpm dev`. Point the pass:// paths at your own vault items; never put real values here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/did_they_answer
OPENROUTER_API_KEY=pass://Personal/OpenRouter/api_key
CRON_SECRET=pass://Personal/did-they-answer/cron_secret
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
